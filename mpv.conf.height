## ===================================================================
## MPV Configuration - Optimized untuk mpv v0.41.0
## RTX 4060 + Ryzen 9 9900X, default stabil di Windows
## ===================================================================

## gpu-hq sudah mengatur scale, dither-depth, error-diffusion, dan sigmoid/linear/correct-downscaling;
## opsi yang nilainya sama dengan default mpv sengaja tidak ditulis ulang.
profile=gpu-hq

## ===================================================================
## Screenshot Settings
## ===================================================================
screenshot-directory="~/Pictures/mpv-screenshots"
screenshot-format=png
screenshot-png-compression=8
screenshot-template="%F-%p-%#n"

## ===================================================================
## UI and Window
## ===================================================================
osd-font-size=32
osd-bar-h=2
osd-border-size=1
title='${media-title} - mpv'
keep-open=yes
force-window=immediate


## ===================================================================
## Video Output - D3D11 (stabil untuk Windows + RTX 4060)
## ===================================================================
vo=gpu-next
gpu-api=d3d11
gpu-context=d3d11
d3d11-adapter="NVIDIA GeForce RTX 4060"

## Hardware Decoding - pasangan yang benar untuk gpu-api=d3d11
## Jangan pakai nvdec/cuda di backend D3D11; itu memicu error CUDA.
hwdec=d3d11va
## hwdec fallback ke software decode otomatis jika format tidak didukung GPU.

## Catatan:
## Jika ingin uji Vulkan/NVDEC, jalankan:
## mpv --profile=vulkan-nvdec "video.mkv"

## GPU Shader Cache
gpu-shader-cache-dir="~~/shader_cache"

## ===================================================================
## Scaling - High Quality untuk AI Upscaling
## ===================================================================
cscale=ewa_lanczossharp
dscale=mitchell
scale-antiring=0.7
cscale-antiring=0.7

## ===================================================================
## AI Upscaling Shader - ArtCNN C4F32 DS
## ===================================================================
## Satu-satunya shader. Hook ArtCNN punya syarat WHEN (output >=1.3x luma), jadi otomatis tidak
## jalan untuk video >=1080p di layar 1080p; tidak perlu profile per resolusi. Jangan dirantai
## dengan nnedi3: setelah luma digandakan, ArtCNN tidak lagi memenuhi syaratnya.
glsl-shaders="~~/shaders/ArtCNN_C4F32_DS.glsl"

## Shader optimization untuk RTX 4060
gpu-dumb-mode=no
fbo-format=rgba16hf

## ===================================================================
## Frame Timing & Interpolation
## ===================================================================
video-sync=display-resample
interpolation=yes
tscale=oversample
tscale-window=sphinx
tscale-radius=1.0
tscale-clamp=0.0

## ===================================================================
## Dithering - Maximum Quality
## ===================================================================
temporal-dither=yes

## ===================================================================
## Debanding - tuned supaya minim banding tanpa over-smoothing
## ===================================================================
deband=yes
deband-iterations=4
deband-threshold=40
deband-grain=28

## ===================================================================
## HDR Support
## ===================================================================
hdr-compute-peak=yes

## ===================================================================
## Cache - Balanced untuk Startup Cepat & Streaming Smooth
## ===================================================================
cache=yes
demuxer-max-back-bytes=75M
demuxer-readahead-secs=10
demuxer-mkv-subtitle-preroll=yes

## Network cache (hanya untuk streaming)
cache-secs=10
stream-buffer-size=4M

## ===================================================================
## Audio Settings
## ===================================================================
volume-max=150
audio-normalize-downmix=yes
audio-file-auto=fuzzy

## ===================================================================
## Language Preferences
## ===================================================================
alang=ja,jp,jpn,en,eng,id,ind
slang=id,ind,en,eng,ja,jp,jpn
sub-auto=fuzzy
sub-file-paths=ass:srt:sub:subs:subtitles

## ===================================================================
## Subtitle Styling
## ===================================================================
## scale (bukan force): ukuran/warna style lain (catatan, papan, dll.) tetap sesuai
## subtitle asli, jadi rasio ukuran antar-style tidak berubah.
sub-ass-override=scale
## Font family + bold berlaku ke semua style. Fontsize sengaja tidak di-override
## (ukuran absolut membuat style lain tidak proporsional); ukuran dialog utama
## diatur scripts/sub-size-normalize.lua lewat sub-scale agar selalu = sub-font-size.
sub-ass-style-overrides=Fontname=Gandhi Sans,Bold=1,Default.Kerning=yes
## sub-scale juga berlaku untuk papan/signs, supaya rasio ke dialog tetap.
sub-scale-signs=yes
sub-fonts-dir="~~/fonts"
sub-font="Gandhi Sans"
sub-font-size=46
sub-bold=yes
sub-border-size=2
sub-shadow-offset=0.5
sub-shadow-color="#33000000"
sub-margin-y=36

## ASS subtitle settings
sub-ass-force-margins=yes

## ===================================================================
## OSD/OSC Customization
## ===================================================================
osd-duration=2000
osd-playing-msg='${filename}'

## ===================================================================
## Scripts
## ===================================================================
## Desktop tanpa baterai, dan preset ini tidak punya profile battery/full-performance.
## Tanpa ini power-profile.lua menjalankan PowerShell (~0.3 detik) tiap 10 detik tanpa efek.
script-opts-append=power-profile-enabled=no

## ===================================================================
## Profiles untuk Berbagai Use Cases
## ===================================================================

[4k-native]
profile-desc="Untuk video 4K native (matikan upscaling)"
glsl-shaders=""
scale=spline36
cscale=spline36
deband-iterations=2

[low-quality-source]
profile-desc="Untuk source berkualitas rendah (heavy denoise)"
deband-threshold=64
deband-range=20

[streaming]
profile-desc="Untuk streaming online (cache lebih besar)"
demuxer-max-bytes=300M
demuxer-readahead-secs=20
stream-buffer-size=8M
ytdl-format=bestvideo[height<=?1080]+bestaudio/best

[performance]
profile-desc="Performance mode (disable heavy features)"
glsl-shaders=""
interpolation=no
deband=no
scale=spline36
cscale=spline36

[vulkan-nvdec]
profile-desc="Eksperimen untuk RTX 4060: Vulkan + NVDEC"
gpu-api=vulkan
gpu-context=winvk
vulkan-device="NVIDIA GeForce RTX 4060"
hwdec=nvdec,auto-safe

[max-quality]
profile-desc="Maximum quality (berat)"
deband-threshold=48

## ===================================================================
## Protocol Specific
## ===================================================================

[protocol.http]
profile=streaming
user-agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
referrer="https://www.google.com/"

[protocol.https]
profile=streaming
user-agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

[protocol.ytdl]
profile=streaming
ytdl-format=bestvideo[height<=?1080][vcodec!=vp9]+bestaudio/best

## ===================================================================
## Extension Specific
## ===================================================================

[extension.webm]
loop-file=inf

[extension.gif]
loop-file=inf
interpolation=no

[extension.mp4]
demuxer-lavf-analyzeduration=10
